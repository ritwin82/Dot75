{
  "name": "LocalMesh Sensei",
  "url": "https://YOUR_PUBLIC_HOST",
  "hook_attributes": { "url": "https://YOUR_PUBLIC_HOST/webhooks/github", "active": true },
  "callback_urls": ["https://YOUR_API_HOST/auth/github/callback"],
  "setup_url": "https://YOUR_API_HOST/github/setup",
  "setup_on_update": true,
  "public": true,
  "default_permissions": { "contents": "read", "pull_requests": "read", "checks": "write", "issues": "write", "metadata": "read" },
  "default_events": ["pull_request", "merge_group", "push", "repository"]
}
